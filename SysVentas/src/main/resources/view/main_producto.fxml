<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.ProductoController">

    <children>

        <VBox layoutX="14.0" layoutY="14.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">

            <children>

                <!-- TÍTULO Y BÚSQUEDA -->
                <AnchorPane>
                    <children>

                        <Label layoutX="14.0" layoutY="14.0" text="Productos">

                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>

                        </Label>

                        <Label layoutX="295.0" layoutY="44.0" text="Filtrar Productos" />

                        <TextField fx:id="txtFiltroDato" layoutX="295.0" layoutY="69.0" />

                        <Button layoutX="457.0" layoutY="69.0" mnemonicParsing="false" text="Buscar" />

                    </children>

                    <padding>
                        <Insets bottom="5.0" />
                    </padding>

                </AnchorPane>


                <!-- FORMULARIO Y TABLA -->
                <HBox maxHeight="1.7976931348623157E308">

                    <children>

                        <!-- FORMULARIO -->
                        <AnchorPane>

                            <children>

                                <GridPane layoutY="5.0">

                                    <columnConstraints>

                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />

                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />

                                    </columnConstraints>


                                    <rowConstraints>

                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />

                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />

                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints />

                                    </rowConstraints>


                                    <children>

                                        <!-- TÍTULO -->
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Formulario de Registro" GridPane.columnSpan="2" />


                                        <!-- NOMBRE -->
                                        <Label text="Nombre Producto" GridPane.rowIndex="1" />

                                        <TextField fx:id="txtNombreProducto" GridPane.columnIndex="1" GridPane.rowIndex="1" />


                                        <!-- BOTONES -->
                                        <Button mnemonicParsing="false" onAction="#validarFormulario" text="Guardar" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" text="" GridPane.columnSpan="2" GridPane.rowIndex="3" />

                                    </children>

                                    <padding>
                                        <Insets left="5.0" />
                                    </padding>

                                </GridPane>

                            </children>

                        </AnchorPane>


                        <!-- TABLA -->
                        <AnchorPane>

                            <children>

                                <TableView fx:id="tableView" layoutX="6.0" layoutY="30.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />

                            </children>

                        </AnchorPane>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
